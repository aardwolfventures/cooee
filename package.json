{
  "name": "cooee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cooee v1 prototype \u2014 simulated off-grid mate tracking",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build:standalone": "vite build --base ./ && node scripts/standalone.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "pinia": "^3.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.17",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.10"
  }
}
